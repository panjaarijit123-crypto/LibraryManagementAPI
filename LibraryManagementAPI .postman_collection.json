    {
      "name": "01 - Create test book",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now().toString();",
              "pm.collectionVariables.set('testIsbn', '978' + stamp.slice(-13));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set('bookId', data.bookId); }",
              "pm.test('Book was created', function () { pm.expect(pm.response.json().title).to.eql('Postman Test Java Book'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Test Java Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"category\": \"Programming\",\n  \"totalCopies\": 10,\n  \"availableCopies\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/library/api/book/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "library",
